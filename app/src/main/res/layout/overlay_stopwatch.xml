<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/stopwatchRoot"
    android:layout_width="270dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_tool_card"
    android:elevation="14dp"
    android:orientation="vertical">

    <!-- Header / drag bar -->
    <LinearLayout
        android:id="@+id/stopwatchHeader"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_tool_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_stopwatch" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Stopwatch"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseStopwatch"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="Close"
            android:padding="7dp"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Time display -->
    <TextView
        android:id="@+id/tvStopwatchTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="00:00.00"
        android:textColor="@color/geneo_text_primary"
        android:textSize="38sp"
        android:textStyle="bold" />

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingBottom="6dp">

        <ImageButton
            android:id="@+id/btnLap"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="Lap"
            android:padding="12dp"
            android:src="@drawable/ic_flag" />

        <ImageButton
            android:id="@+id/btnStartPauseStopwatch"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginEnd="18dp"
            android:background="@drawable/bg_round_button_accent"
            android:contentDescription="Start"
            android:padding="16dp"
            android:src="@drawable/ic_play" />

        <ImageButton
            android:id="@+id/btnResetStopwatch"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/bg_round_button"
            android:contentDescription="Reset"
            android:padding="11dp"
            android:src="@drawable/ic_reset" />
    </LinearLayout>

    <!-- Laps -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxHeight="120dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/lapsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="14dp" />
    </ScrollView>

</LinearLayout>
